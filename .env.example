# Content OS secrets — copy to .env and fill in. .env is gitignored; never commit real values.
#
# The notify seam (`contentos notify`) and the Beats read these from the environment. For local
# testing, `set -a; . ./.env; set +a` then run `contentos notify ...`. In the scheduled Claude
# routines (the Beats), set them as routine secrets instead of a file.
#
# See docs/agents/notify.md for how to obtain both values.

# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# The chat id the pings are delivered to.
TELEGRAM_CHAT_ID=
