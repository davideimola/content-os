#!/usr/bin/env bash
#
# fake-curl — a test double for curl, injected into bin/notify via NOTIFY_CURL.
# It emulates only the curl behaviour the notify seam relies on, so the tests
# never touch the network or the real Telegram API:
#
#   -o <file>            write the canned response body to <file>
#   -w '%{http_code}'    print the canned HTTP status code to stdout
#
# The canned response and the process outcome are controlled via env vars:
#   FAKE_HTTP_CODE   status code to print   (default: 200)
#   FAKE_BODY        response body to write (default: {"ok":true})
#   FAKE_EXIT        process exit code      (default: 0; non-zero = transport failure)
#   FAKE_ARGS_OUT    if set, every argument is recorded here (one per line) for assertions
set -u

out_file=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-o" ]; then
    out_file="$arg"
  fi
  prev="$arg"
done

if [ -n "${FAKE_ARGS_OUT:-}" ]; then
  : > "$FAKE_ARGS_OUT"
  for arg in "$@"; do
    printf '%s\n' "$arg" >> "$FAKE_ARGS_OUT"
  done
fi

if [ "${FAKE_BODY+set}" = set ]; then
  body="$FAKE_BODY"
else
  body='{"ok":true}'
fi

if [ -n "$out_file" ]; then
  printf '%s' "$body" > "$out_file"
fi

printf '%s' "${FAKE_HTTP_CODE:-200}"
exit "${FAKE_EXIT:-0}"
