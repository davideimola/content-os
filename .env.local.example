# content-os-web (ADR-0016) — copy to .env.local and fill in. .env.local is
# gitignored; never commit real values.
#
# On Vercel, the Supabase vars are provided automatically by the Vercel–Supabase
# integration (same names) — you only set the AUTH_* vars there by hand.

# ── Supabase (read + RPC writes, server-side only) ───────────────────────────
# The service_role key bypasses RLS and must never reach the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Auth.js single-user gate (Google, no password) ───────────────────────────
# Required. Generate with:  openssl rand -base64 33
AUTH_SECRET=
# Comma-separated allowlist of Google emails permitted to sign in.
AUTH_ALLOWED_EMAIL=you@example.com
# Google OAuth app credentials (Google Cloud Console → Credentials → OAuth client).
# The gate stays OPEN until AUTH_GOOGLE_ID is set, then requires a signed-in,
# allowlisted user. Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
